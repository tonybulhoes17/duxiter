# ============================================================
# DUXITER — environment variables
# Copy this file to .env.local and fill in the values.
# ============================================================

# ---- Supabase (required for Milestone 1) ----
# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PARTNERS_ENABLED=false

# ---- Google Maps (Milestone: tour player) ----
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---- Google Vision (Milestone: museum camera ID) ----
GOOGLE_VISION_API_KEY=

# ---- OpenAI (Milestone: AI itinerary) ----
OPENAI_API_KEY=

# ---- Stripe (Milestone: payments) ----
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Resend (Milestone: email) ----
RESEND_API_KEY=
